---
import { NEWSLETTER_OPEN } from '../lib/site';
interface Props { id?: string; button?: string }
const { id = 'newsletter', button = 'Subscribe' } = Astro.props;
---
{/* TODO: point `action` at the Brevo double opt-in endpoint (see README), then set NEWSLETTER_OPEN = true. */}
<form method="post" action="/api/newsletter" class="mt-8 max-w-xl">
  <fieldset disabled={!NEWSLETTER_OPEN} class="contents">
    <label for={`${id}-email`} class="block text-[0.9375rem] font-semibold uppercase tracking-wide">Email address</label>
    <div class="mt-2 flex flex-col sm:flex-row gap-3">
      <input id={`${id}-email`} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com"
        class="flex-1 min-h-12 rounded-full border-2 border-current bg-transparent px-5 py-2 text-inherit" />
      <button type="submit" class="btn btn-solid">{NEWSLETTER_OPEN ? button : 'Opening soon'}</button>
    </div>
  </fieldset>
  <p class="mt-3 text-[0.9375rem]">
    {NEWSLETTER_OPEN
      ? <>We send a confirmation email first (double opt-in). Unsubscribe any time. </>
      : <>Signup is not open yet. </>}
    See the <a href="/legal/privacy/" class="underline">privacy policy</a>.
  </p>
</form>
