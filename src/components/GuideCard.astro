---
import { guideUrl, formatDate, type Guide } from '../lib/guides';
interface Props { guide: Guide; topicTitle?: string }
const { guide, topicTitle } = Astro.props;
---
<article class="border-t border-line py-6">
  <h3 class="h3 text-2xl"><a href={guideUrl(guide)} class="no-underline hover:underline">{guide.data.title}</a></h3>
  <p class="mt-2 max-w-2xl text-muted">{guide.data.description}</p>
  <p class="mt-2 text-sm text-muted">{topicTitle && <>{topicTitle} · </>}<time datetime={guide.data.publishedAt.toISOString()}>{formatDate(guide.data.publishedAt)}</time></p>
</article>
