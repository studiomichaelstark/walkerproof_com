---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getGuides, guideUrl, formatDate } from '../lib/guides';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const allGuides = await getGuides();
const guides = allGuides.slice(0, 3);
const topics = await getCollection('topics');
const titles = new Map(topics.map((t) => [t.id, t.data.title]));
const counts = new Map(topics.map((t) => [t.id, allGuides.filter((g) => g.data.topic.id === t.id).length]));
---
<Base title={SITE.name} description="Plain-English guides on gear care, footwear, rain gear, cold weather and hiking. No tracking, no cookies.">
  <section id="hero" aria-labelledby="hero-title" class="wrap section text-center">
    <h1 id="hero-title" class="display">Gear that <span class="text-accent">lasts.</span></h1>
    <p class="lead mx-auto mt-6">Short, practical guides on caring for your outdoor gear and choosing what actually works. Nothing tracks you here.</p>
    <p class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/guides/" class="btn btn-solid">Read the guides</a>
      <a href="/checklist/" class="btn">Get the checklist</a>
    </p>
    <span class="ph mt-14 aspect-[16/9] md:aspect-[21/9]" aria-hidden="true"><Mark /></span>
  </section>

  <section id="topics" aria-labelledby="topics-title" class="wrap section pt-0">
    <h2 id="topics-title" class="h2 text-center">Find your topic</h2>
    <ul class="mt-10 border-t border-line" role="list">
      {topics.map((t) => (
        <li class="border-b border-line">
          <a href={`/topics/${t.id}/`} class="flex items-baseline justify-between gap-6 py-5 no-underline hover:text-accent">
            <span class="h2">{t.data.title}</span>
            <span class="shrink-0 text-sm font-semibold uppercase tracking-wide text-muted">{counts.get(t.id)} {counts.get(t.id) === 1 ? 'guide' : 'guides'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="guides" aria-labelledby="guides-title" class="wrap section pt-0">
    <h2 id="guides-title" class="h2 text-center">Latest guides</h2>
    {guides.length ? (
      <ul class="mt-10 grid gap-8 md:grid-cols-3" role="list">
        {guides.map((g) => (
          <li>
            <a href={guideUrl(g)} class="block no-underline hover:text-accent">
              <span class="ph aspect-[4/3]" aria-hidden="true"><Mark /></span>
              <span class="mt-4 block h3">{g.data.title}</span>
              <span class="mt-1 block text-sm text-muted">{titles.get(g.data.topic.id)} · <time datetime={g.data.publishedAt.toISOString()}>{formatDate(g.data.publishedAt)}</time></span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="lead mx-auto mt-6 text-center text-muted">The first guides are on the way. Subscribe below and we send you a note when they land.</p>
    )}
    <p class="mt-8 text-center"><a href="/guides/" class="btn btn-sm">All guides</a></p>
  </section>

  <section id="private" aria-labelledby="private-title" class="field-ink">
    <div class="grid md:grid-cols-2">
      <span class="ph min-h-72 md:min-h-[30rem]" aria-hidden="true"><Mark /></span>
      <div class="px-5 py-14 md:px-12 md:py-20 self-center">
        <h2 id="private-title" class="h2">No cookies. No trackers. No nonsense.</h2>
        <p class="lead mt-5">No cookies, no local storage, no third-party requests. Fonts are hosted here. When a guide has affiliate links, it says so at the top.</p>
        <p class="mt-8"><a href="/legal/privacy/" class="btn">Privacy policy</a></p>
      </div>
    </div>
  </section>

  <section id="checklist" aria-labelledby="checklist-title" class="field-sand text-center">
    <div class="wrap section">
      <h2 id="checklist-title" class="h2">The gear care checklist</h2>
      <p class="lead mx-auto mt-5">One page. What to check before and after every trip, so your gear keeps working.</p>
      <p class="mt-8"><a href="/checklist/" class="btn btn-solid">Get the checklist</a></p>
    </div>
  </section>

  <section id="newsletter" aria-labelledby="newsletter-title" class="wrap section text-center">
    <h2 id="newsletter-title" class="display">Stay in the know.</h2>
    <p class="lead mx-auto mt-5">One short email when a new guide is published.</p>
    <div class="mx-auto max-w-xl text-left"><NewsletterForm id="home-nl" /></div>
  </section>
</Base>
