---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { getGuides, guideUrl, formatDate } from '../lib/guides';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const guides = (await getGuides()).slice(0, 6);
const topics = await getCollection('topics');
const titles = new Map(topics.map((t) => [t.id, t.data.title]));
const fields = ['field-coral', 'field-sand', 'field-red', 'field-coral', 'field-sand'];
---
<Base title={SITE.name} description="Plain-English guides on gear care, footwear, rain gear, cold weather and hiking. No tracking, no cookies.">
  <section id="hero" aria-labelledby="hero-title" class="field-red relative overflow-hidden md:min-h-[36rem]">
    <div class="wrap section">
      <div class="relative z-10 md:max-w-[58%]">
        <h1 id="hero-title" class="display">Gear that lasts.</h1>
        <p class="lead mt-6">Short, practical guides on caring for your outdoor gear and choosing what actually works. Nothing tracks you here.</p>
        <p class="mt-8 flex flex-wrap gap-3">
          <a href="/guides/" class="btn btn-solid">Read the guides</a>
          <a href="/checklist/" class="btn">Get the checklist</a>
        </p>
      </div>
    </div>
    <Mark class="relative block ml-auto -mt-4 w-[70%] max-w-sm translate-x-[22%] translate-y-[26%] md:absolute md:right-0 md:bottom-0 md:mt-0 md:w-[38%] md:max-w-none md:translate-x-[16%] md:translate-y-[24%]" />
  </section>

  <section id="topics" aria-labelledby="topics-title" class="section">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="topics-title" class="h2">Find your topic</h2>
        <a href="/topics/" class="btn btn-sm">All topics</a>
      </div>
    </div>
    <ul class="rail rail-bleed mt-8" role="list" tabindex="0" aria-label="Topics">
      {topics.map((t, i) => (
        <li>
          <a href={`/topics/${t.id}/`} class:list={['ph', fields[i % fields.length], 'block no-underline']} style="aspect-ratio: 4 / 5;">
            <Mark />
            <span class="absolute inset-x-0 top-0 p-5 h3 uppercase">{t.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="guides" aria-labelledby="guides-title" class="section pt-0">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4 border-t border-line pt-14">
        <h2 id="guides-title" class="h2">Latest guides</h2>
        <a href="/guides/" class="btn btn-sm">All guides</a>
      </div>
      {guides.length ? (
        <ul class="rail mt-8" role="list" tabindex="0" aria-label="Latest guides">
          {guides.map((g, i) => (
            <li>
              <a href={guideUrl(g)} class="block no-underline">
                <span class:list={['ph', fields[(i + 1) % fields.length]]} style="aspect-ratio: 4 / 3;"></span>
                <span class="mt-3 block h3">{g.data.title}</span>
                <span class="mt-1 block text-sm text-muted">{titles.get(g.data.topic.id)} · <time datetime={g.data.publishedAt.toISOString()}>{formatDate(g.data.publishedAt)}</time></span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="lead mt-8 text-muted">The first guides are on the way. Subscribe below and we send you a note when they land.</p>
      )}
    </div>
  </section>

  <section id="private" aria-labelledby="private-title" class="field-panel">
    <div class="grid md:grid-cols-2">
      <span class="ph field-coral min-h-72 md:min-h-[32rem]" aria-hidden="true"><Mark /></span>
      <div class="px-5 py-14 md:px-12 md:py-20 self-center">
        <h2 id="private-title" class="h2">No cookies. No trackers. No nonsense.</h2>
        <p class="lead mt-5">No cookies, no local storage, no third-party requests. Fonts are hosted here. When a guide has affiliate links, it says so at the top.</p>
        <p class="mt-8"><a href="/legal/privacy/" class="btn">Privacy policy</a></p>
      </div>
    </div>
  </section>

  <section id="checklist" aria-labelledby="checklist-title" class="field-sand">
    <div class="grid md:grid-cols-2">
      <div class="px-5 py-14 md:px-12 md:py-20 self-center md:order-1">
        <h2 id="checklist-title" class="h2">The gear care checklist</h2>
        <p class="lead mt-5">One page. What to check before and after every trip, so your gear keeps working.</p>
        <p class="mt-8"><a href="/checklist/" class="btn btn-solid">Get the checklist</a></p>
      </div>
      <span class="ph field-panel min-h-72 md:min-h-[32rem]" aria-hidden="true"><Mark /></span>
    </div>
  </section>

  <section id="newsletter" aria-labelledby="newsletter-title" class="field-red">
    <div class="wrap section">
      <h2 id="newsletter-title" class="display">Stay in the know.</h2>
      <p class="lead mt-5">One short email when a new guide is published.</p>
      <NewsletterForm id="home-nl" />
    </div>
  </section>
</Base>
