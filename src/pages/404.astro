---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section id="not-found" aria-labelledby="nf-title" class="border-b border-line">
    <div class="wrap section">
  <h1 id="nf-title" class="display">Page not found</h1>
  <p class="lead mt-5">The page you want is not here. Try the <a href="/guides/" class="underline">guides</a> or go <a href="/" class="underline">home</a>.</p>
</div>
  </section>
</Base>
