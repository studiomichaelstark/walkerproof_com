---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---
<Base title="About" description="Who is behind Walkerproof, and how to get in touch.">
  <h1 class="font-serif text-4xl font-semibold">About</h1>
  <div class="prose prose-lg mt-6 max-w-none">
    <p>Walkerproof publishes short, practical guides on outdoor gear care and hiking. It is written by Michael Konjevic in Stuttgart, Germany. (Placeholder text.)</p>
    <p>The site uses no cookies and no trackers.</p>
    <h2>Contact</h2>
    <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </div>
</Base>
