---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title="Free gear care checklist" description="A one-page checklist for caring for your outdoor gear. Free by email.">
  <section id="checklist-hero" aria-labelledby="checklist-title" class="border-b border-line">
    <div class="wrap section">
      <h1 id="checklist-title" class="display">The gear care checklist</h1>
      <p class="lead mt-5">One page. Everything to check before and after a trip, so your gear keeps working.</p>
    </div>
  </section>
  <section id="checklist-contents" aria-labelledby="inside-title" class="wrap section">
    <h2 id="inside-title" class="h2">What is inside</h2>
  <ul class="mt-6 list-disc pl-6 space-y-2 lead">
    <li>Clean and dry gear after every trip</li>
    <li>Re-proof rain gear when water stops beading</li>
    <li>Check boots, zips and seams</li>
    <li>Store everything dry and uncompressed</li>
  </ul>
  </section>
  <section id="checklist-form" aria-labelledby="send-title" class="border-b border-line">
    <div class="wrap section">
      <h2 id="send-title" class="h2">Send it to me</h2>
      <p class="lead mt-4">Enter your email and we send the checklist after you confirm.</p>
      <NewsletterForm id="checklist" button="Send me the checklist" />
    </div>
  </section>
</Base>
