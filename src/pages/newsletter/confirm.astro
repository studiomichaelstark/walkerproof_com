---
import Base from '../../layouts/Base.astro';
---
<Base title="Check your inbox" description="Confirm your email address to finish subscribing." noindex>
  <section id="confirm" aria-labelledby="confirm-title" class="field-red">
    <div class="wrap section">
  <h1 id="confirm-title" class="display">Check your inbox</h1>
  <p class="lead mt-5">We sent you an email. Click the link inside to confirm your address. Nothing is sent until you do.</p>
  <p class="mt-4">No email after a few minutes? Check your spam folder.</p>
</div>
  </section>
</Base>
