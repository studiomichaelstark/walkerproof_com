---
import { render } from 'astro:content';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getGuides, guideSlug, guideUrl, formatDate } from '../../lib/guides';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.filter((g) => g.id.startsWith('en/')).map((guide) => ({ params: { slug: guideSlug(guide) }, props: { guide } }));
}
const { guide } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);
const topic = (await getEntry(data.topic))!;
const author = (await getEntry(data.author))!;
const url = new URL(guideUrl(guide), Astro.site).href;
const heroUrl = data.hero ? new URL(data.hero.src, Astro.site).href : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    datePublished: data.publishedAt.toISOString(),
    dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
    author: { '@type': 'Person', name: author.data.name, ...(author.data.url && { url: author.data.url }) },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: url,
    inLanguage: 'en',
    ...(heroUrl && { image: heroUrl }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: SITE.url + '/guides/' },
      { '@type': 'ListItem', position: 3, name: topic.data.title, item: `${SITE.url}/topics/${topic.id}/` },
      { '@type': 'ListItem', position: 4, name: data.title, item: url },
    ],
  },
];
---
<Base title={data.title} description={data.description} type="article" jsonLd={jsonLd} image={heroUrl}>
  <section id="guide-header" aria-labelledby="guide-title" class="field-coral">
    <div class="wrap section">
      <nav aria-label="Breadcrumb" class="text-sm font-semibold uppercase tracking-wide">
        <ol class="flex flex-wrap gap-x-2">
          <li><a href="/guides/" class="underline">Guides</a></li><li aria-hidden="true">/</li>
          <li><a href={`/topics/${topic.id}/`} class="underline">{topic.data.title}</a></li>
        </ol>
      </nav>
      <h1 id="guide-title" class="display mt-4" style="font-size: clamp(2.25rem, 1rem + 5.4vw, 4.5rem);">{data.title}</h1>
      <p class="mt-6 text-sm font-medium">
        By {author.data.name} · Published <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
        {data.updatedAt && <> · Updated <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time></>}
      </p>
    </div>
  </section>
  <article id="guide-body" class="wrap section">
    {data.hero && <Image src={data.hero} alt={data.heroAlt ?? ''} class="mb-10 w-full h-auto" widths={[480, 768, 1024]} sizes="(min-width: 768px) 720px, 100vw" loading="eager" />}
    {data.hasAffiliateLinks && (
      <p id="affiliate-note" class="mb-8 max-w-prose border-2 border-current p-4 text-sm">
        This guide contains affiliate links. If you buy through them, we may earn a commission at no extra cost to you. <a href="/legal/affiliate-disclosure/" class="underline">Details</a>.
      </p>
    )}
    <div class="prose prose-lg"><Content /></div>
  </article>
  <section id="guide-author" aria-labelledby="author-box" class="field-sand">
    <div class="wrap py-12">
      <h2 id="author-box" class="text-sm font-semibold uppercase tracking-wide">About the author</h2>
      <p class="mt-3 h3">{author.data.url ? <a href={author.data.url} class="underline">{author.data.name}</a> : author.data.name}</p>
      <p class="mt-2 max-w-prose">{author.data.bio}</p>
    </div>
  </section>
</Base>
