---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getGuides } from '../../lib/guides';
import { getCollection } from 'astro:content';

const guides = await getGuides();
const topics = await getCollection('topics');
const titles = new Map(topics.map((t) => [t.id, t.data.title]));
---
<Base title="All guides" description="Every Walkerproof guide on gear care, footwear, rain gear, cold weather and hiking.">
  <section id="guides-list" aria-labelledby="guides-title" class="wrap section">
  <h1 id="guides-title" class="display">Guides</h1>
  <nav aria-label="Filter by topic" class="mt-8">
    <ul class="flex flex-wrap gap-2" role="list">
      <li><a href="/guides/" aria-current="page" class="btn btn-solid btn-sm">All</a></li>
      {topics.map((t) => <li><a href={`/topics/${t.id}/`} class="btn btn-sm">{t.data.title}</a></li>)}
    </ul>
  </nav>
  <div class="mt-10">
    {guides.length ? guides.map((g) => <GuideCard guide={g} topicTitle={titles.get(g.data.topic.id)} />) : <p class="text-muted">No guides yet.</p>}
  </div>
</section>
</Base>
