---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { getGuides } from '../../lib/guides';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  const guides = await getGuides();
  return topics.map((topic) => ({
    params: { topic: topic.id },
    props: { topic, guides: guides.filter((g) => g.data.topic.id === topic.id) },
  }));
}
const { topic, guides } = Astro.props;
---
<Base title={topic.data.title} description={topic.data.description}>
  <section id="topic-header" aria-labelledby="topic-title" class="field-coral">
    <div class="wrap section">
      <p class="text-sm font-semibold uppercase tracking-wide"><a href="/topics/" class="underline">Topics</a></p>
      <h1 id="topic-title" class="display mt-3">{topic.data.title}</h1>
      <p class="lead mt-5">{topic.data.description}</p>
    </div>
  </section>
  <section id="topic-guides" aria-label="Guides in this topic" class="wrap section">
    {guides.length ? guides.map((g) => <GuideCard guide={g} />) : <p class="lead text-muted">No guides in this topic yet.</p>}
  </section>
</Base>
