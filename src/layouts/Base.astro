---
import '../styles/global.css';
import { SITE } from '../lib/site';
import Arrow from '../components/Arrow.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  image?: string;
}
const { title, description, type = 'website', noindex = false, jsonLd = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const lang = Astro.currentLocale ?? SITE.defaultLocale;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const nav = [
  { href: '/guides/', label: 'Guides' },
  { href: '/topics/', label: 'Topics' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok');</script>
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:p-3 focus:text-black">Skip to content</a>
    <header id="site-header" class="sticky top-3 z-40 px-3 pt-3 md:px-8">
      <div class="pill-nav mx-auto flex max-w-[100rem] items-center justify-between gap-4 px-4 py-2 md:px-6">
        <a href="/" class="text-2xl font-medium tracking-tight no-underline" aria-label="Walkerproof, home">Walkerproof</a>
        <nav aria-label="Main navigation" class="hidden md:block">
          <ul class="flex items-center gap-1" role="list">
            {nav.map((n) => (
              <li><a href={n.href} class="nav-link" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-2">
          <button id="theme-toggle" type="button" hidden aria-pressed="true" class="nav-link cursor-pointer" aria-label="Switch colour theme"><span data-theme-label>Light</span></button>
          <a href="/checklist/" class="btn btn-solid btn-sm hidden sm:inline-flex">Get the checklist <Arrow /></a>
          <details class="relative md:hidden">
            <summary class="nav-link cursor-pointer list-none [&::-webkit-details-marker]:hidden">Menu</summary>
            <ul class="pill-nav absolute right-0 top-12 w-56 !rounded-3xl p-2" role="list">
              {nav.map((n) => (
                <li><a href={n.href} class="nav-link w-full" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
              ))}
              <li><a href="/checklist/" class="btn btn-solid btn-sm mt-2 w-full">Get the checklist</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer id="site-footer" class="border-t border-line">
      <div class="wrap py-16">
        <div class="grid gap-10 md:grid-cols-[2fr_1fr] md:items-end">
          <div>
            <p class="display" data-reveal>Stay dry.<br />Stay curious.</p>
            <p class="lead mt-6">Plain-English guides on gear that keeps you dry. No cookies. No trackers.</p>
          </div>
          <nav aria-label="Footer navigation">
            <ul class="flex flex-col gap-1 text-lg" role="list">
              <li><a href="/guides/" class="inline-block py-1 no-underline hover:text-accent">Guides</a></li>
              <li><a href="/topics/" class="inline-block py-1 no-underline hover:text-accent">Topics</a></li>
              <li><a href="/checklist/" class="inline-block py-1 no-underline hover:text-accent">Checklist</a></li>
              <li><a href="/legal/imprint/" class="inline-block py-1 no-underline hover:text-accent">Imprint</a></li>
              <li><a href="/legal/privacy/" class="inline-block py-1 no-underline hover:text-accent">Privacy</a></li>
            </ul>
          </nav>
        </div>
        <p class="mt-14 text-sm text-muted">&copy; {new Date().getFullYear()} {SITE.name}. Made in Stuttgart.</p>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
    <script is:inline>
      // Theme toggle. Dark is the default. Nothing is stored (no cookie, no localStorage),
      // so a light choice lasts for the current page view only.
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var label = btn.querySelector('[data-theme-label]');
        function isDark() { return root.getAttribute('data-theme') !== 'light'; }
        function sync() { var d = isDark(); btn.setAttribute('aria-pressed', String(d)); label.textContent = d ? 'Light' : 'Dark'; }
        btn.hidden = false;
        btn.addEventListener('click', function () { root.setAttribute('data-theme', isDark() ? 'light' : 'dark'); sync(); });
        sync();
      })();
    </script>
  </body>
</html>
