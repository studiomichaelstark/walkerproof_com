---
import '../styles/global.css';
import { SITE } from '../lib/site';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  image?: string;
}
const { title, description, type = 'website', noindex = false, jsonLd = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const lang = Astro.currentLocale ?? SITE.defaultLocale;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const nav = [
  { href: '/guides/', label: 'Guides' },
  { href: '/topics/', label: 'Topics' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f2e9d8" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion-ok');</script>
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-white focus:p-3 focus:text-black">Skip to content</a>
    <header id="site-header" class="border-b border-line">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-1 py-4">
        <a href="/" aria-label="Walkerproof, home" class="inline-block py-1 text-ink"><Logo class="h-11 w-auto md:h-14" /></a>
        <nav aria-label="Main navigation">
          <ul class="flex flex-wrap gap-x-7 text-sm font-semibold uppercase tracking-wide" role="list">
            {nav.map((n) => (
              <li><a href={n.href} class="inline-block border-b-2 border-transparent py-2 no-underline hover:text-accent aria-[current=page]:border-current aria-[current=page]:text-accent" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li hidden><button id="theme-toggle" type="button" aria-pressed="false" class="inline-block cursor-pointer py-2 font-semibold uppercase tracking-wide underline decoration-1 underline-offset-4 hover:text-accent"><span data-theme-label>Dark</span> mode</button></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer id="site-footer" class="border-t border-line">
      <div class="wrap py-12">
        <a href="/" aria-label="Walkerproof, home" class="inline-block text-ink"><Logo class="h-10 w-auto" /></a>
        <p class="mt-4 max-w-md text-muted">Plain-English guides on gear that keeps you dry. No cookies. No trackers.</p>
        <div class="mt-8 flex flex-wrap justify-between gap-4 text-sm">
          <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
          <nav aria-label="Footer navigation">
            <ul class="flex gap-6 font-semibold uppercase tracking-wide" role="list">
              <li><a href="/legal/imprint/" class="inline-block py-2 hover:text-accent">Imprint</a></li>
              <li><a href="/legal/privacy/" class="inline-block py-2 hover:text-accent">Privacy</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/motion';
    </script>
    <script is:inline>
      // Theme toggle. Nothing is stored: no cookie, no localStorage. It follows the OS setting
      // until the visitor flips it, and the choice lasts for the current page view only.
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var label = btn.querySelector('[data-theme-label]');
        function isDark() {
          var t = root.getAttribute('data-theme');
          return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function sync() { var d = isDark(); btn.setAttribute('aria-pressed', String(d)); label.textContent = d ? 'Light' : 'Dark'; }
        btn.parentNode.hidden = false;
        btn.addEventListener('click', function () { root.setAttribute('data-theme', isDark() ? 'light' : 'dark'); sync(); });
        sync();
      })();
    </script>
  </body>
</html>
