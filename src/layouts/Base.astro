---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
  image?: string;
}
const { title, description, type = 'website', noindex = false, jsonLd = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;
const lang = Astro.currentLocale ?? SITE.defaultLocale;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const nav = [
  { href: '/guides/', label: 'Guides' },
  { href: '/topics/', label: 'Topics' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:bg-white focus:p-2">Skip to content</a>
    <header class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <a href="/" class="font-semibold tracking-tight text-lg no-underline">{SITE.name}</a>
        <nav aria-label="Main navigation">
          <ul class="flex gap-5 text-sm">
            {nav.map((n) => (
              <li><a href={n.href} class="py-2 inline-block hover:underline" aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1 mx-auto w-full max-w-3xl px-5 py-10 sm:py-14">
      <slot />
    </main>
    <footer class="border-t border-line text-sm text-muted">
      <div class="mx-auto max-w-3xl px-5 py-6 flex flex-wrap justify-between gap-3">
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
        <nav aria-label="Footer navigation">
          <ul class="flex gap-5">
            <li><a href="/legal/imprint/" class="hover:underline">Imprint</a></li>
            <li><a href="/legal/privacy/" class="hover:underline">Privacy</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
